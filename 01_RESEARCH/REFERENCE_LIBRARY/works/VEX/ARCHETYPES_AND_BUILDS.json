    {
      "id": "VEX-A01",
      "name": "Heron",
      "lines": "196–235",
      "engine": "Second-card economy supporting larger threats and prolonged holds",
      "dependencies": [
        "safe legal deployment location",
        "surviving payoff",
        "usable second-card costs"
      ],
      "source_config": "3 Heron; heavier top-end; excludes core Empower package in this variant",
      "advantages": "Later resource/value conversion and fewer weak early package dependencies",
      "weakness": "Clunky hands, fast pressure, efficient bounce/removal after large investment",
      "selection": "Test when slower opponents allow deployment and when bounce punishes the Empower variant more severely.",
      "status": "pilot_hypothesis"
    },
    {
      "id": "VEX-A02",
      "name": "Empower/Kharox",
      "lines": "236–284",
      "engine": "Steel Paws/Tornado Warrior early defense and Kharox conditional opposing-trash access",
      "dependencies": [
        "eligible Empower target",
        "correct location and Hidden timing",
        "useful eligible opposing trash",
        "sufficient interaction"
      ],
      "source_config": "3 Steel Paws and 3 Tornado Warrior advocated together; 1–2 Kharox; hybrid 2 Heron possible",
      "advantages": "Early board potential and flexible midgame",
      "weakness": "Bounce, missing targets, poor opposing trash, predictable setup",
      "selection": "Test against early pressure and valuable unit-based decks; compare against gear-focused and bounce-heavy opponents.",
      "status": "pilot_hypothesis"
    },
    {
      "id": "VEX-A03",
      "name": "Illaoi tokens",
      "lines": "285–331",
      "engine": "Token generation, distributed presence and payoff scaling",
      "dependencies": [
        "token generators and surviving payoff",
        "legal scoring route",
        "opponent wide-board answers"
      ],
      "source_config": "Illaoi and Zed as payoffs, Baron proposed later; not classic concentrated hold",
      "advantages": "Multiple bodies and reduced exposure to single-target answers",
      "weakness": "Generator/payoff mismatch, low standalone bodies, wide-board removal and costly late draws",
      "selection": "Test when distribution is useful and opposing answers are disproportionately single-target.",
      "status": "pilot_hypothesis"
    }
